# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Faqat shu Telegram user ID'lar botni boshqara oladi (vergul bilan). ID ni @userinfobot dan oling.
ADMIN_IDS=111111111

# --- Claude (Anthropic API) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modellar zanjiri — eng yaxshisidan boshlab (vergul bilan).
# Model limitga yetsa (429) yoki band bo'lsa keyingisiga o'tadi,
# MODEL_COOLDOWN sekunddan keyin yana eng yaxshisiga avtomatik qaytadi.
CLAUDE_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
MODEL_COOLDOWN=300
# low | medium | high | xhigh | max
CLAUDE_EFFORT=high

# --- Sayt ---
# Kuzatiladigan URL'lar (vergul bilan)
SITE_URLS=https://example.com
# Sayt fayllari joylashgan papka (Claude shu yerda ishlaydi)
SITE_DIR=/var/www/example.com
# Sahifada bo'lishi shart bo'lgan matn (ixtiyoriy, bo'sh qoldirish mumkin)
SITE_KEYWORD=
# Tekshirish oralig'i (sekund)
CHECK_INTERVAL=60
# Javob vaqti shu ms dan oshsa ogohlantirish
SLOW_THRESHOLD_MS=3000
# Disk/RAM/CPU foizi shundan oshsa ogohlantirish
RESOURCE_ALERT_PERCENT=90
# Kuzatiladigan log fayllar (vergul bilan)
LOG_FILES=/var/log/nginx/error.log,/var/log/nginx/access.log

# --- Xavfsizlik ---
# dangerous = faqat xavfli buyruqlar uchun tasdiq so'raydi (tavsiya)
# all       = har bir buyruq/yozish uchun tasdiq so'raydi
# none      = hech narsa so'ramaydi (XAVFLI!)
CONFIRM_MODE=dangerous
# Sayt tushganda Claude avtomatik tahlil qilsinmi
AUTO_DIAGNOSE=true
# Tahlildan keyin Claude o'zi tuzatishga harakat qilsinmi (xavfli amallar baribir tasdiq so'raydi)
AUTO_FIX=false
# Buyruq bajarilishi uchun maksimal vaqt (sekund)
COMMAND_TIMEOUT=300
# Fayl ustidan yozishdan oldin zaxira nusxa shu yerga saqlanadi
BACKUP_DIR=/var/backups/site-guardian
